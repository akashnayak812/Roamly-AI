# ============================================================
# Roamly AI — Environment Variables Example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://roamly:roamly_password@localhost:5432/roamly_db
REDIS_URL=redis://localhost:6379/0

# ── Security ────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
FIREBASE_PROJECT_ID=curecast-468bb

# ── Gemini / Google AI ──────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# ── Hotel Dataset & Catalog ──────────────────────────────────
HOTEL_DATASET_PATH=data/processed/hotels.json
HOTEL_DATASET_RAW_PATH=data/raw/hotels.csv
HOTEL_DATASET_QUALITY_PATH=data/processed/hotels_data_quality.json

# ── Google Maps & Places ─────────────────────────────────────
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
MAPS_API_KEY=

# ── SerpApi (Live Web Search) ────────────────────────────────
SERPAPI_API_KEY=
SERPAPI_ENGINE=google_maps
SERPAPI_TIMEOUT_SECONDS=15
SERPAPI_CACHE_TTL_SECONDS=1800

# ── Amadeus Travel APIs ──────────────────────────────────────
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ── Restaurant API ────────────────────────────────────────────
RESTAURANT_API_KEY=your_restaurant_api_key_here
RESTAURANT_API_BASE_URL=https://api.your-restaurant-provider.com/v1

# ── Storage ──────────────────────────────────────────────────
STORAGE_BUCKET=roamly-assets
STORAGE_URL=https://storage.your-cloud.com

# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=Roamly AI
APP_VERSION=1.0.0
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
BACKEND_PORT=8000

# ── Frontend ─────────────────────────────────────────────────
# These are passed to Next.js — prefix public vars with NEXT_PUBLIC_
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAPS_API_KEY=AIzaSyBNxLHDTU1CHiC4F9SRwzjnCdqoXTF1opM
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCZ3-DUerundBtTelapnpB5leMiAoX4tsQ
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=curecast-468bb.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=curecast-468bb
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=curecast-468bb.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=566203072332
NEXT_PUBLIC_FIREBASE_APP_ID=1:566203072332:web:a78944518e41ac943b99e9
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-V90LYCY3W5

# ── MLflow ───────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5001

# ── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
